# ---- database -------------------------------------------------------------
ANCHOR_PG_DSN=postgresql://anchor:anchor@localhost:5433/anchor

# ---- generation -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional local generator backend (phase 3). Ignored unless generator_backend=vllm.
ANCHOR_VLLM_BASE_URL=http://localhost:8000/v1

# ---- observability (optional; both no-op if unset) ------------------------
WANDB_API_KEY=
WANDB_PROJECT=anchor
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- ingest ---------------------------------------------------------------
# vLLM commit to pin the corpus to. Every document row records this.
ANCHOR_VLLM_COMMIT=
